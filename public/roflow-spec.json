{
  "system": "NUWA Kebbi + Firebase Realtime Database",
  "version": "3.0.0",
  "base_url": "https://kebbi-wallet-default-rtdb.asia-southeast1.firebasedatabase.app",

  "create_order": {
    "method": "POST",
    "url": "https://kebbi-wallet-default-rtdb.asia-southeast1.firebasedatabase.app/orders.json",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "robot_id": "KEBBI_ROBOT_001",
      "total_amount": 100,
      "status": "PENDING",
      "items": [
        {
          "name": "餐點",
          "quantity": 1,
          "price": 100
        }
      ]
    },
    "response_mapping": {
      "name": "order_id"
    }
  },

  "check_order": {
    "method": "GET",
    "url": "https://kebbi-wallet-default-rtdb.asia-southeast1.firebasedatabase.app/orders/{{order_id}}.json",
    "response_mapping": {
      "status": "order_status"
    },
    "statuses": [
      "PENDING",
      "PAID",
      "EXPIRED"
    ]
  },

  "qr_code": {
    "content": "{{order_id}}",
    "image_url": "https://quickchart.io/qr?size=300&text={{order_id}}"
  }
}

